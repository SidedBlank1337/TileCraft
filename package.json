{
  "name": "tilecraft_realms",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,client \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "start": "cross-env NODE_ENV=production tsx server/index.ts",
    "test:e2e": "tsx tests/e2e/two_browser.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "cross-env NODE_ENV=test node --import tsx --test --test-concurrency=1 tests/*.test.ts",
    "db:init": "tsx server/tools/db_tool.ts init",
    "db:check": "tsx server/tools/db_tool.ts check",
    "db:backup": "tsx server/tools/db_tool.ts backup",
    "db:cleanup": "tsx server/tools/db_tool.ts cleanup",
    "admin:grant": "tsx server/tools/db_tool.ts grant_admin"
  },
  "dependencies": {
    "express": "^4.22.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sqlite3": "^6.0.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "playwright-core": "^1.63.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.2"
  }
}
